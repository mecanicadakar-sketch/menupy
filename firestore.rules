rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'mecanicadakar@gmail.com' && request.auth.token.email_verified == true;
    }

    // Default deny for all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Perfiles y configuraciones del negocio del usuario indexados por UID (PII Isolation)
    // Solo el dueño de la cuenta o el administrador general pueden acceder a datos personales y configuración
    match /users/{userId} {
      allow read: if isOwner(userId) || isMasterAdmin();
      allow create, update: if isOwner(userId) || isMasterAdmin();
      allow delete: if isMasterAdmin();
    }

    // Colección de comercios públicos
    // La lectura de menús y datos públicos es abierta, pero la modificación está restringida al dueño o admin
    match /stores/{storeId} {
      allow read: if true;
      allow create, update: if isSignedIn() && (isOwner(storeId) || isMasterAdmin());
      allow delete: if isMasterAdmin();
    }

    // Documento de verificación de conexión
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
